eclipse.preferences.version=1
gdb.client.commands=set mem inaccessible-by-default off
gdb.client.doStart=true
gdb.client.executable=arm-none-eabi-gdb
gdb.client.other=
gdb.openocd.doDebugInRam=false
gdb.openocd.doInitialReset=false
gdb.openocd.doPreRunReset=false
gdb.openocd.enableSemihosting=false
gdb.openocd.init.other=monitor reset\nmonitor halt
gdb.openocd.initialReset.type=init
gdb.openocd.preRun.other=monitor soft_reset_halt
gdb.openocd.preRunReset.type=halt
gdb.server.doStart=true
gdb.server.executable=${OPENOCD_PATH}/openocd
gdb.server.other=-f /home/andy/Documents/TallerProyectoI/herramientas/firmware_v3-r1.3.0/scripts/openocd/lpc4337.cfg
